# Application Configuration
PROJECT_NAME="NexPharmAI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication
# IMPORTANT: Generate a strong secret in production: openssl rand -hex 32
JWT_SECRET="nexpharm_enterprise_super_secret_jwt_key_2026_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Default fallback to sqlite during local testing if postgres is not yet running
DATABASE_URL="sqlite:///./nexpharm.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+psycopg2://nexpharm_user:nexpharm_secure_password_2026@localhost:5432/nexpharm_db"

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Machine Learning Models Directory
MODEL_PATH="../ml/models"

# AI Decision Assistant LLM Provider (Optional)
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-pro"
